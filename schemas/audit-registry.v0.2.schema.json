{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.adumun.org/audit/audit-registry.v0.2.schema.json",
  "title": "ADÜMÜN Audit Program Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["auditProgramVersion", "schemaVersion", "status", "mode", "queueStatusVocabulary", "readinessDecisionVocabulary", "principles", "queue", "artifactPattern", "standard", "outcomes"],
  "properties": {
    "auditProgramVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schemaVersion": {"const": "0.2.0"},
    "status": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "queueStatusVocabulary": {
      "type": "array",
      "items": {"enum": ["QUEUED", "IN_PROGRESS", "COMPLETED", "SUPERSEDED", "CANCELLED"]},
      "uniqueItems": true
    },
    "readinessDecisionVocabulary": {
      "type": "array",
      "items": {"enum": ["YES", "YES_WITH_CONDITIONS", "NO"]},
      "uniqueItems": true
    },
    "principles": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "queue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["order", "repository", "status", "rationale"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "auditId": {"type": "string", "pattern": "^AUD-[0-9]{3,}$"},
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "status": {"enum": ["QUEUED", "IN_PROGRESS", "COMPLETED", "SUPERSEDED", "CANCELLED"]},
          "auditedAt": {"type": "string", "format": "date"},
          "artifact": {"type": "string", "pattern": "^evidence/(historical|current)/.+\\.ya?ml$"},
          "supersedesAuditId": {"type": ["string", "null"], "pattern": "^AUD-[0-9]{3,}$"},
          "supersededByAuditId": {"type": ["string", "null"], "pattern": "^AUD-[0-9]{3,}$"},
          "result": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "maturity": {"enum": ["R0", "R1", "R2", "R3", "R4", "R5"]},
              "readinessDecision": {"enum": ["YES", "YES_WITH_CONDITIONS", "NO"]},
              "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]}
            }
          },
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "selectionAfterSeed": {"type": "object"},
    "artifactPattern": {"type": "string", "minLength": 1},
    "standard": {"type": "string", "minLength": 1},
    "outcomes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
